    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "playwright": "^1.48.0",
    "resend": "^4.0.0",
    "stripe": "^17.3.0"
