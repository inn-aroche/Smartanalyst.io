# Bind interne uniquement — Nginx fait le pont vers /admin/deploy/*
DEPLOY_SERVER_HOST=127.0.0.1
DEPLOY_SERVER_PORT=3001

# Token long (≥ 32 chars). Génère avec `openssl rand -base64 48`.
# Doit matcher EXACTEMENT le secret GitHub DEPLOY_TOKEN.
DEPLOY_TOKEN=change-me-openssl-rand-base64-48

# Chemin local du repo cloné (avec deploy key SSH).
REPO_PATH=/srv/smartanalyst-repo

LOG_LEVEL=info
