# ━━━ Server ━━━
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:5173
# Comma-separated list of allowed CORS origins. Falls back to APP_URL if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# Admin token pour /admin/queues/* (observabilité DLQ + retry).
# Doit faire ≥ 32 chars. Génère avec `openssl rand -hex 32`.
# REQUIRED en production — sinon les endpoints /admin répondent 503.
ADMIN_TOKEN=change-me-openssl-rand-hex-32

# ━━━ Supabase ━━━
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ━━━ Vault (Supabase Vault — chiffrement secrets) ━━━
# OBLIGATOIRE en production. Sans ça, tokens OAuth stockés en clair.
# Voir docs/06_SUPABASE_BONNES_PRATIQUES.md §3.
VAULT_ENABLED=false

# ━━━ Stripe ━━━
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...

# ━━━ Redis (BullMQ + Cache) ━━━
REDIS_URL=redis://localhost:6379

# ━━━ Google Gemini (AI) ━━━
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# ━━━ Google (GA4, Google Ads, Search Console) ━━━
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/oauth/callback?source=google

# ━━━ Google Sign-In (login / signup with Google) ━━━
# Separate GCP OAuth client from the connectors one above. Scopes used:
# openid email profile. Requires the Google provider to be enabled in
# Supabase dashboard (Auth → Providers → Google) with the same client ID/secret.
GOOGLE_LOGIN_CLIENT_ID=yyy.apps.googleusercontent.com
GOOGLE_LOGIN_CLIENT_SECRET=GOCSPX-...
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# ━━━ Meta (Facebook / Instagram Ads) ━━━
META_APP_ID=123456789
META_APP_SECRET=abc123...
META_REDIRECT_URI=http://localhost:3000/auth/oauth/callback?source=meta

# ━━━ Shopify (Ecommerce, public OAuth app) ━━━
SHOPIFY_API_KEY=xxx
SHOPIFY_API_SECRET=xxx

# ━━━ OAuth générique (catalog en DB depuis migration 011) ━━━
# Redirect URI utilisée par tous les flows OAuth si aucun override par
# provider. Doit matcher EXACTEMENT ce qui est configuré chez chaque
# provider (Google Cloud Console, Meta App, Shopify Partner Dashboard…).
OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/connectors/oauth/callback

# ━━━ Resend (transactional email) ━━━
RESEND_API_KEY=re_...
EMAIL_FROM=rapport@smartanalyst.io

# ━━━ Beta lockdown ━━━
# Comma-separated allowlist d'emails. Si non vide, seuls ces emails peuvent
# signup / login / utiliser l'API. Si vide → mode ouvert (signup public).
# À activer pendant la période pré-launch (pas de billing en place) pour
# éviter qu'un user random créé un compte. À vider à la livraison du SaaS.
# Voir apps/api/src/lib/beta-access.js.
BETA_ALLOWED_EMAILS=

# ━━━ Observability (optional) ━━━
LOG_LEVEL=info
SLACK_WEBHOOK_URL=

# Sentry — error tracking + performance. No-op si DSN vide (dev local).
# Crée un projet Node.js sur https://sentry.io et copie le DSN ici.
# SENTRY_RELEASE est injecté automatiquement par scripts/deploy-api.sh au
# moment du deploy (= git rev-parse HEAD). À NE PAS commiter dans le .env prod.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
