---
import '../styles/dark.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { STRINGS, switchLocalePath } from '../i18n/strings.js';

const { title, description, locale = 'en', jsonLd = [] } = Astro.props;
const siteName = 'SmartAnalyst';
const fullTitle = title === 'home'
  ? (locale === 'fr'
      ? `${siteName} — Ton analyste marketing IA`
      : `${siteName} — Your AI Marketing Data Analyst`)
  : `${title} — ${siteName}`;

const altLocale = locale === 'en' ? 'fr' : 'en';
const altPath = switchLocalePath(Astro.url.pathname, altLocale);
const siteUrl = Astro.site || 'https://smartanalyst.io';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const altHref = new URL(altPath, siteUrl).href;
const ogImage = new URL('/og-image.svg', siteUrl).href;

// Org + WebSite JSON-LD shipped on every page. SoftwareApplication, FAQPage
// and any page-specific entries come through the `jsonLd` prop.
const baseJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: siteName,
    url: 'https://smartanalyst.io',
    logo: new URL('/favicon.svg', siteUrl).href,
    description:
      locale === 'fr'
        ? 'Analyste marketing IA. Connecte GA4, Meta Ads, Google Ads, Stripe et Search Console et obtient des réponses structurées sur tes performances marketing.'
        : 'AI marketing data analyst. Connect GA4, Meta Ads, Google Ads, Stripe and Search Console and get structured answers about your marketing performance.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: 'https://smartanalyst.io',
    inLanguage: ['en', 'fr'],
  },
];
const allJsonLd = [...baseJsonLd, ...jsonLd];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={altLocale} href={altHref} />
    <link rel="alternate" hreflang="x-default" href={new URL(locale === 'en' ? Astro.url.pathname : altPath, siteUrl).href} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {allJsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MCHTX3BG');</script>
    <!-- End Google Tag Manager -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MCHTX3BG"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <Nav locale={locale} />
    <slot />
    <Footer locale={locale} />

    <script is:inline>
      // Nav: blur + background once scrolled
      (() => {
        const nav = document.getElementById('nav');
        if (!nav) return;
        const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 30);
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
      // Reveal-on-scroll for .sa-fade elements
      (() => {
        const els = document.querySelectorAll('.sa-fade');
        if (!els.length) return;
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add('visible'); }),
          { threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
