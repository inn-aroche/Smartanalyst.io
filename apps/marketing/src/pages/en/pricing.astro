---
import DarkBase from '../../layouts/DarkBase.astro';
import { PLANS, PLAN_ORDER, TRIAL_DAYS } from '@smartanalyst/shared/pricing';

// English UI strings for plans (the shared package is French-only for now).
const PLAN_LABELS_EN = {
  FREE:    { label: 'Discovery', tagline: 'To discover the product, no strings attached' },
  STARTER: { label: 'Starter',   tagline: 'For the freelance or small business owning their marketing' },
  PRO:     { label: 'Pro',       tagline: 'For the agency managing 5 to 20 clients' },
  AGENCY:  { label: 'Agency',    tagline: 'For agencies with an unlimited client portfolio' },
};

function quotaEn(value) {
  if (value === Infinity) return 'Unlimited';
  if (value === 'all_p1') return 'All P1';
  if (value === 'all')    return 'All';
  return String(value);
}

function whiteLabelEn(level) {
  switch (level) {
    case 'none':        return 'SmartAnalyst branded';
    case 'logo':        return 'Your logo';
    case 'logo_colors': return 'Logo + colors';
    case 'full':        return 'Full white-label';
    default:            return level;
  }
}
---
<DarkBase
  title="Pricing"
  description="Discovery, Starter, Pro and Agency plans. 14-day free trial, no credit card. AI included in every plan."
  locale="en"
>
  <section class="page-hero">
    <div class="glow" style="width:700px;height:500px;top:-100px;left:50%;transform:translateX(-50%);opacity:0.55"></div>
    <div class="container" style="position:relative;z-index:1">
      <div class="eyebrow">Pricing</div>
      <h1>One price per usage,<br /><span class="gradient-text">not per feature.</span></h1>
      <p class="lead">
        AI is included in <strong>every plan</strong> — it’s the core of the product, not a premium add-on. Pick a plan based on the number of clients you manage, not the features you unlock.
      </p>
      <p class="lead" style="font-size:14px;color:var(--text-3)">{TRIAL_DAYS}-day free trial · no credit card</p>
    </div>
  </section>

  <section class="page-section sa-fade">
    <div class="container">
      <div class="grid cols-4">
        {PLAN_ORDER.map((key) => {
          const plan = PLANS[key];
          const en = PLAN_LABELS_EN[key];
          return (
            <article class={`plan ${plan.featured ? 'featured' : ''}`}>
              {plan.featured && <span class="badge">Most popular</span>}
              <h3>{en.label}</h3>
              <p class="plan-tag">{en.tagline}</p>
              <p class="price">€{plan.priceEurMonth}<small> / month</small></p>
              <ul>
                <li>{quotaEn(plan.quotas.clients)} client{plan.quotas.clients !== 1 ? 's' : ''}</li>
                <li>{quotaEn(plan.quotas.connectors)} connector{plan.quotas.connectors === 1 ? '' : 's'}</li>
                <li>{quotaEn(plan.quotas.insightsPerMonth)} insights / month</li>
                <li>{whiteLabelEn(plan.quotas.whiteLabel)}</li>
                <li>{plan.quotas.autoSendReports ? 'Auto-sent reports on the 1st' : 'No auto-send'}</li>
                <li>Unlimited AI chat</li>
              </ul>
              {plan.priceEurMonth === 0 ? (
                <a href="/en/#cta" class="btn" style="justify-content:center">Get started</a>
              ) : (
                <a href="/en/#cta" class={`btn ${plan.featured ? 'btn-primary' : ''}`} style="justify-content:center">
                  Try {TRIAL_DAYS} days
                </a>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="page-section alt sa-fade">
    <div class="container">
      <h2>Plan details</h2>
      <p class="lead">Every feature, every quota — side by side.</p>
      <table class="compare">
        <thead>
          <tr>
            <th></th>
            {PLAN_ORDER.map((key) => <th>{PLAN_LABELS_EN[key].label}</th>)}
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Monthly price</td>
            {PLAN_ORDER.map((key) => <td><strong>€{PLANS[key].priceEurMonth}</strong></td>)}
          </tr>
          <tr>
            <td>Clients</td>
            {PLAN_ORDER.map((key) => <td>{quotaEn(PLANS[key].quotas.clients)}</td>)}
          </tr>
          <tr>
            <td>Connectors</td>
            {PLAN_ORDER.map((key) => <td>{quotaEn(PLANS[key].quotas.connectors)}</td>)}
          </tr>
          <tr>
            <td>Insights / month</td>
            {PLAN_ORDER.map((key) => <td>{quotaEn(PLANS[key].quotas.insightsPerMonth)}</td>)}
          </tr>
          <tr>
            <td>Conversational analysis</td>
            {PLAN_ORDER.map(() => <td>✓</td>)}
          </tr>
          <tr>
            <td>Real-time dashboard</td>
            {PLAN_ORDER.map(() => <td>✓</td>)}
          </tr>
          <tr>
            <td>Auto-reports on the 1st</td>
            {PLAN_ORDER.map((key) => <td>{PLANS[key].quotas.autoSendReports ? '✓' : '—'}</td>)}
          </tr>
          <tr>
            <td>White-label</td>
            {PLAN_ORDER.map((key) => <td>{whiteLabelEn(PLANS[key].quotas.whiteLabel)}</td>)}
          </tr>
          <tr>
            <td>Competitive benchmark</td>
            <td>—</td>
            <td>✓</td>
            <td>✓</td>
            <td>✓</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="page-section sa-fade">
    <div class="container">
      <h2>Frequently asked questions</h2>
      <div class="grid cols-2">
        <div class="sa-card">
          <h3>Can I cancel anytime?</h3>
          <div class="card-body">Yes. No commitment, no penalty. You keep access through the end of the paid period. After expiry, you have 7 days read-only to export your data — nothing is deleted abruptly.</div>
        </div>
        <div class="sa-card">
          <h3>Is the trial really card-free?</h3>
          <div class="card-body">Really. Email + password, that’s it. {TRIAL_DAYS} days of full access. You only pay if you decide to continue.</div>
        </div>
        <div class="sa-card">
          <h3>Is AI limited on the Discovery plan?</h3>
          <div class="card-body">No — conversational AI is <strong>unlimited on every plan</strong>. The Discovery limit is on auto-generated proactive insights (3/month vs 100+ on paid plans) and connectors (1 only).</div>
        </div>
        <div class="sa-card">
          <h3>Is my data safe?</h3>
          <div class="card-body">EU hosting (Supabase, Ireland region). OAuth tokens encrypted with Supabase Vault. Row-Level Security across the whole database. GDPR by design. <a href="/en/security">More details on the security page</a>.</div>
        </div>
        <div class="sa-card">
          <h3>Which connectors are available today?</h3>
          <div class="card-body">GA4, Meta Ads (Facebook + Instagram), Google Ads, Stripe and Google Search Console. Roadmap: Shopify, HubSpot, Mailchimp, LinkedIn Ads.</div>
        </div>
        <div class="sa-card">
          <h3>Do you bill in euros?</h3>
          <div class="card-body">Yes, in euros, VAT included. Monthly billing via Stripe. French VAT applied based on your status. Invoices downloadable from your dashboard.</div>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section alt sa-fade" style="text-align:center">
    <div class="container">
      <h2>Still not sure?</h2>
      <p class="lead">The Discovery plan is free forever. Connect 1 tool, ask your first questions, judge for yourself.</p>
      <a href="/en/#cta" class="btn btn-primary">Request early access</a>
    </div>
  </section>
</DarkBase>
