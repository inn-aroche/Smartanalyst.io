---
import DarkBase from '../../layouts/DarkBase.astro';
import { PLANS, PUBLIC_PLAN_ORDER, TRIAL_DAYS } from '@smartanalyst/shared/pricing';

// English UI strings for plans (the shared package is French-only for now).
const PLAN_LABELS_EN = {
  FREE: { label: 'Discovery', tagline: 'To discover the product, no strings attached' },
  STARTER: { label: 'Starter', tagline: 'For the freelance or small business owning their marketing' },
  PRO: { label: 'Pro', tagline: 'For the indie or SMB managing their marketing day to day' },
  AGENCY: { label: 'Agency', tagline: 'For agencies with an unlimited client portfolio' },
};

function quotaEn(value) {
  if (value === Infinity) return 'Unlimited';
  if (value === 'all_p1') return 'All P1';
  if (value === 'all')    return 'All';
  return String(value);
}

function whiteLabelEn(level) {
  switch (level) {
    case 'none':        return 'SmartAnalyst branded';
    case 'logo':        return 'Your logo';
    case 'logo_colors': return 'Logo + colors';
    case 'full':        return 'Full white-label';
    default:            return level;
  }
}

// FAQPage JSON-LD: rich results in Google + citable answers for LLMs.
// Keep in sync with the visible FAQ block below, these are the same Q/A.
const faqEntries = [
  {
    q: 'Can I cancel anytime?',
    a: 'Yes. No commitment, no penalty. You keep access through the end of the paid period. After expiry, you have 7 days read-only to export your data, nothing is deleted abruptly.',
  },
  {
    q: 'Is the trial really card-free?',
    a: `Really. Email + password, that's it. ${TRIAL_DAYS} days of full access. You only pay if you decide to continue.`,
  },
  {
    q: 'Is AI limited on the Discovery plan?',
    a: 'Yes, every plan includes a monthly AI credit allowance (messages sent to the model). Discovery is sized to evaluate the product, Starter for steady solo use, Pro for intensive multi-source work with Deep mode. You see your remaining balance in real time and get an 80% alert. No surprise overage charges.',
  },
  {
    q: 'Is my data safe?',
    a: 'EU hosting (Supabase, Ireland region). OAuth tokens encrypted with Supabase Vault. Row-Level Security across the whole database. GDPR by design.',
  },
  {
    q: 'Which connectors are available today?',
    a: 'GA4, Meta Ads (Facebook + Instagram), Google Ads, Stripe and Google Search Console. Roadmap: Shopify, HubSpot, Mailchimp, LinkedIn Ads.',
  },
  {
    q: 'Do you bill in euros?',
    a: 'Yes, in euros, VAT included. Monthly billing via Stripe. French VAT applied based on your status. Invoices downloadable from your dashboard.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'SmartAnalyst',
  description:
    'AI marketing data analyst. Connect GA4, Meta Ads, Google Ads, Stripe and Search Console and get structured answers about your performance.',
  brand: { '@type': 'Brand', name: 'SmartAnalyst' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: 0,
    highPrice: Math.max(...PUBLIC_PLAN_ORDER.map((k) => PLANS[k].priceEurMonth)),
    offerCount: PUBLIC_PLAN_ORDER.length,
  },
};
---
<DarkBase
  title="Pricing"
  description="Discovery, Starter and Pro plans. AI included in every plan, no add-on."
  locale="en"
  ogImage="/og/pricing.svg"
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <section class="page-hero">
    <div class="glow" style="width:700px;height:500px;top:-100px;left:50%;transform:translateX(-50%);opacity:0.55"></div>
    <div class="container" style="position:relative;z-index:1">
      <div class="eyebrow">Pricing</div>
      <h1>One price per usage,<br /><span class="gradient-text">not per feature.</span></h1>
      <p class="lead">
        AI is included in <strong>every plan</strong>, it’s the core of the product, not a premium add-on. Pick a plan based on the number of clients you manage, not the features you unlock.
      </p>
      <p class="lead" style="font-size:14px;color:var(--text-3)">{TRIAL_DAYS}-day free trial · no credit card</p>
    </div>
  </section>

  <section class="page-section sa-fade">
    <div class="container">
      <div class="grid cols-3">
        {PUBLIC_PLAN_ORDER.map((key) => {
          const plan = PLANS[key];
          const en = PLAN_LABELS_EN[key];
          return (
            <article class={`plan ${plan.featured ? 'featured' : ''}`}>
              {plan.featured && <span class="badge">Most popular</span>}
              <h3>{en.label}</h3>
              <p class="plan-tag">{en.tagline}</p>
              <p class="price">€{plan.priceEurMonth}<small> / month</small></p>
              <ul>
                <li>{quotaEn(plan.quotas.clients)} client{plan.quotas.clients !== 1 ? 's' : ''}</li>
                <li>{quotaEn(plan.quotas.connectors)} connector{plan.quotas.connectors === 1 ? '' : 's'}</li>
                <li>{quotaEn(plan.quotas.insightsPerMonth)} insights / month</li>
                <li>{whiteLabelEn(plan.quotas.whiteLabel)}</li>
                <li>{plan.quotas.autoSendReports ? 'Auto-sent reports on the 1st' : 'No auto-send'}</li>
                <li>Monthly AI credit allowance</li>
              </ul>
              {plan.priceEurMonth === 0 ? (
                <a href="/en/beta" class="btn" style="justify-content:center">Get started</a>
              ) : (
                <a href="/en/beta" class={`btn ${plan.featured ? 'btn-primary' : ''}`} style="justify-content:center">
                  Try {TRIAL_DAYS} days
                </a>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="page-section alt sa-fade">
    <div class="container">
      <h2>Plan details</h2>
      <p class="lead">Every feature, every quota, side by side.</p>
      <div class="compare-wrap">
        <table class="compare">
          <thead>
            <tr>
              <th></th>
              {PUBLIC_PLAN_ORDER.map((key) => <th>{PLAN_LABELS_EN[key].label}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Monthly price</td>
              {PUBLIC_PLAN_ORDER.map((key) => <td><strong>€{PLANS[key].priceEurMonth}</strong></td>)}
            </tr>
            <tr>
              <td>Clients</td>
              {PUBLIC_PLAN_ORDER.map((key) => <td>{quotaEn(PLANS[key].quotas.clients)}</td>)}
            </tr>
            <tr>
              <td>Connectors</td>
              {PUBLIC_PLAN_ORDER.map((key) => <td>{quotaEn(PLANS[key].quotas.connectors)}</td>)}
            </tr>
            <tr>
              <td>Insights / month</td>
              {PUBLIC_PLAN_ORDER.map((key) => <td>{quotaEn(PLANS[key].quotas.insightsPerMonth)}</td>)}
            </tr>
            <tr>
              <td>Conversational analysis</td>
              {PUBLIC_PLAN_ORDER.map(() => <td>✓</td>)}
            </tr>
            <tr>
              <td>Real-time dashboard</td>
              {PUBLIC_PLAN_ORDER.map(() => <td>✓</td>)}
            </tr>
            <tr>
              <td>Auto-reports on the 1st</td>
              {PUBLIC_PLAN_ORDER.map((key) => <td>{PLANS[key].quotas.autoSendReports ? '✓' : '·'}</td>)}
            </tr>
            <tr>
              <td>White-label</td>
              {PUBLIC_PLAN_ORDER.map((key) => <td>{whiteLabelEn(PLANS[key].quotas.whiteLabel)}</td>)}
            </tr>
            <tr>
              <td>Competitive benchmark</td>
              {PUBLIC_PLAN_ORDER.map((key) => (
                <td>{PLANS[key].priceEurMonth > 0 ? '✓' : '·'}</td>
              ))}
            </tr>
            <tr>
              <td>Deep mode (AI)</td>
              {PUBLIC_PLAN_ORDER.map((key) => (
                <td>{key === 'PRO' || key === 'AGENCY' ? '✓' : '·'}</td>
              ))}
            </tr>
            <tr>
              <td>Pin to dashboard (chat)</td>
              {PUBLIC_PLAN_ORDER.map((key) => (
                <td>{key === 'PRO' || key === 'AGENCY' ? '✓' : '·'}</td>
              ))}
            </tr>
            <tr>
              <td>Slide deck export</td>
              {PUBLIC_PLAN_ORDER.map((key) => (
                <td>{key === 'PRO' || key === 'AGENCY' ? '✓' : '·'}</td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="page-section sa-fade">
    <div class="container faq-container">
      <h2>Frequently asked questions</h2>
      <p class="lead" style="margin-bottom:36px">Everything we’re asked before every signup.</p>
      <div class="faq-list">
        {faqEntries.map((entry, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>
              <span>{entry.q}</span>
              <span class="faq-caret" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer" set:html={entry.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section alt sa-fade" style="text-align:center">
    <div class="container">
      <h2>Still not sure?</h2>
      <p class="lead">The Discovery plan is free forever. Connect 1 tool, ask your first questions, judge for yourself.</p>
      <a href="/en/beta" class="btn btn-primary">Request early access</a>
    </div>
  </section>
</DarkBase>
