---
import DarkBase from '../../../layouts/DarkBase.astro';
import '../../../styles/subpage.css';
import { GLOSSARY_BY_CATEGORY, GLOSSARY } from '../../../data/glossary.js';

// DefinedTermSet JSON-LD: every entry becomes a citable DefinedTerm.
// Surfaces beautifully in Perplexity, ChatGPT search, and Google's
// "knowledge graph" attempts.
const glossaryJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Glossaire marketing & analytics, SmartAnalyst',
  url: 'https://smartanalyst.io/fr/resources/glossary/',
  hasDefinedTerm: GLOSSARY.map((e) => ({
    '@type': 'DefinedTerm',
    name: e.fr.term,
    alternateName: e.fr.long,
    description: e.fr.def,
    url: `https://smartanalyst.io/fr/resources/glossary/#${e.slug}`,
  })),
};
---
<DarkBase
  title="Glossaire marketing & analytics"
  description="40+ termes essentiels du marketing et de l'analytics définis simplement : ROAS, CAC, LTV, attribution, cohorte, MRR, NRR, et plus encore."
  locale="fr"
  jsonLd={[glossaryJsonLd]}
>
  <section class="sp-hero">
    <div class="sp-hero-glow"></div>
    <div class="sp-hero-inner">
      <span class="sp-kicker">Ressources · Glossaire</span>
      <h1 class="sp-title">Glossaire marketing & analytics.</h1>
      <p class="sp-hero-lead">
        40+ termes essentiels définis simplement, organisés par thème. Chaque entrée a une ancre stable que tu peux partager : <code>#roas</code>, <code>#cac</code>, <code>#ltv</code>…
      </p>
      <div class="sp-glossary-toc">
        {GLOSSARY_BY_CATEGORY.map((cat) => (
          <a href={`#cat-${cat.id}`}>{cat.fr} ({cat.entries.length})</a>
        ))}
      </div>
    </div>
  </section>

  <section class="sp-section">
    <div class="sp-section-inner">
      {GLOSSARY_BY_CATEGORY.map((cat) => (
        <div class="sp-glossary-cat" id={`cat-${cat.id}`}>
          <h3>{cat.fr}</h3>
          {cat.entries.map((entry) => (
            <div class="sp-glossary-entry" id={entry.slug}>
              <h4>{entry.fr.term}</h4>
              <p class="sp-glossary-long">{entry.fr.long}</p>
              <p>{entry.fr.def}</p>
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="sp-cta">
    <div class="sp-cta-inner">
      <h2>Un terme manque ?</h2>
      <p>On l’ajoute. Écris-nous le terme qui te bloque.</p>
      <a href="mailto:hello@smartanalyst.io" class="btn btn-primary">Suggérer un terme</a>
    </div>
  </section>
</DarkBase>
