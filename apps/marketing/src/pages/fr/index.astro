---
import DarkBase from '../../layouts/DarkBase.astro';
import BrandMark from '../../components/BrandMark.astro';
import LogoStrip from '../../components/LogoStrip.astro';
import LogoIcon from '../../components/LogoIcon.astro';
import '../../styles/landing.css';
import { PLANS, PLAN_ORDER } from '@smartanalyst/shared/pricing';

const HERO_CONNECTORS = [
  { icon: 'ga4' },
  { icon: 'meta' },
  { icon: 'google_ads' },
  { icon: 'stripe' },
  { icon: 'search_console' },
];

const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'SmartAnalyst',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: 'https://smartanalyst.io/fr',
  description:
    'Analyste marketing IA conversationnel. Connecte GA4, Meta Ads, Google Ads, Stripe et Search Console pour obtenir des réponses structurées sur tes performances, causes, preuves et actions recommandées.',
  offers: PLAN_ORDER.map((key) => ({
    '@type': 'Offer',
    name: PLANS[key].label,
    price: PLANS[key].priceEurMonth,
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: PLANS[key].priceEurMonth,
      priceCurrency: 'EUR',
      unitText: 'MONTH',
    },
    availability: 'https://schema.org/InStock',
  })),
};
---
<DarkBase
  title="home"
  description="Pose n’importe quelle question sur tes performances marketing. Reçois des réponses structurées avec causes racines, preuves et actions recommandées, instantanément."
  locale="fr"
  jsonLd={[softwareApplication]}
>
  <!-- ─── Hero ────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="glow hero-glow"></div>
    <div class="hero-inner">
      <div class="hero-copy">
        <div class="s-badge">OS d’intelligence marketing</div>
        <h1>
          Tes données marketing,<br />
          <span class="gradient-text">enfin comprises.</span>
        </h1>
        <p class="hero-lead">
          Pose n’importe quelle question sur tes performances marketing.<br />
          Reçois des réponses structurées avec causes, preuves<br />
          et actions recommandées, instantanément.
        </p>
        <div class="hero-ctas">
          <a href="/fr/beta" class="btn btn-primary">Demander un accès</a>
          <a href="#features" class="btn">Voir comment ça marche ↓</a>
        </div>
        <div class="hero-connects">
          <LogoStrip label="Se connecte à" items={HERO_CONNECTORS} variant="marquee" />
        </div>
      </div>
      <div class="hero-chat-wrap">
        <div class="chat-window" id="hero-chat">
          <div class="chat-chrome">
            <div class="chat-traffic">
              <span style="background:#FF5F57"></span>
              <span style="background:#FEBC2E"></span>
              <span style="background:#28C840"></span>
            </div>
            <div class="chat-urlbar"><span>smartanalyst.app</span></div>
            <div class="chat-pills">
              <span class="chat-pill on">GA4</span>
              <span class="chat-pill on">Meta</span>
              <span class="chat-pill on">GTM</span>
              <span class="chat-pill">+4</span>
            </div>
          </div>
          <div class="chat-body">
            <div class="chat-user">
              <div class="chat-bubble user">« Pourquoi notre taux de conversion a baissé cette semaine ? »</div>
            </div>
            <div class="chat-typing" id="chat-typing" hidden>
              <span></span><span></span><span></span>
            </div>
            <div class="chat-response" id="chat-response" hidden>
              <div class="chat-label">Analyse, 3 causes identifiées</div>
              <div class="chat-causes">
                <div class="cause"><span class="cause-icon red">↓</span><div><strong>Trafic mobile −34%</strong>, changement de fenêtre d’attribution iOS 18</div></div>
                <div class="cause"><span class="cause-icon orange">↑</span><div><strong>Abandon checkout +12%</strong>, friction étape 2 depuis mardi</div></div>
                <div class="cause"><span class="cause-icon red">⚠</span><div><strong>Tag GTM manquant sur /checkout</strong>, actif depuis le 18 nov.</div></div>
              </div>
              <div class="chat-actions">
                <span class="chat-action">Corriger le tag GTM →</span>
                <span class="chat-action">A/B tester étape 2</span>
                <span class="chat-action">Revoir les enchères iOS</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Problem ─────────────────────────────────────────────────────── -->
  <section class="problem sa-fade">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">
          Ton équipe jongle avec 12+ outils.<br />Aucun ne donne la réponse.
        </h2>
        <p class="section-sub">Chaque matin, même chaos. Même question sans réponse : « Pourquoi ? »</p>
      </div>
      <div class="ba">
        <div class="ba-before">
          <div class="ba-label">Avant, ton stack actuel</div>
          <div class="ba-tools">
            {['GA4','Google Tag Manager','Meta Ads','Google Ads','Shopify','CRM','Looker Studio','Hotjar','CMP','Search Console','Tableurs','Klaviyo'].map(t => (
              <span class="tool-pill">{t}</span>
            ))}
            <span class="tool-pill ghost">+ 5 autres</span>
          </div>
          <ul class="ba-points red">
            <li>Pas de vue unifiée</li>
            <li>L’analyse manuelle prend des jours</li>
            <li>Des questions sans réponses</li>
            <li>3 000 KPI, 0 priorités</li>
          </ul>
        </div>
        <div class="ba-arrow"><span>→</span></div>
        <div class="ba-after">
          <div class="ba-label ba-label-cyan">Après, SmartAnalyst</div>
          <div class="ba-quote">
            <div class="ba-quote-head"><span class="dot"></span><strong>SmartAnalyst</strong></div>
            <div class="ba-quote-q">« Pourquoi notre taux de conversion a baissé ? »</div>
            <div class="ba-quote-a">→ 3 causes trouvées. 3 actions prêtes.</div>
          </div>
          <ul class="ba-points green">
            <li>Une seule source de vérité</li>
            <li>Analyse instantanée, temps réel</li>
            <li>Causes claires + priorités</li>
            <li>Actions recommandées</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Product Promise ─────────────────────────────────────────────── -->
  <section class="promise sa-fade">
    <div class="glow" style="width:700px;height:700px;top:50%;left:50%;transform:translate(-50%,-50%);opacity:0.6"></div>
    <div class="container">
      <div class="section-head">
        <div class="s-badge">Le produit</div>
        <h2 class="section-title">Ton analyste marketing IA.</h2>
        <p class="section-sub" style="max-width:490px;margin:0 auto">
          Pas un dashboard. Pas un outil BI. Une couche intelligente qui comprend ton business et parle en langage naturel.
        </p>
      </div>
      <div class="cap-grid">
        {[
          { i:'◑', t:'Ton point du matin',          d:'Score de santé, 3 priorités et propositions d’actions, en 3 secondes' },
          { i:'◎', t:'Veille proactive 24/7',       d:'Alertes custom en langage naturel, prévenu avant que ça déraille' },
          { i:'✦', t:'Assistant multimodal',        d:'Pose tes questions à l’oral ou avec un fichier (CSV, PDF, image)' },
          { i:'✓', t:'De l’analyse à l’action',      d:'Cycle proposé → à faire → fait, sans déversoir' },
          { i:'▤', t:'Rapport mensuel auto',         d:'Synthèse prête à partager — pour toi ou ton board' },
          { i:'◉', t:'Source unique de vérité',      d:'GA4, Meta, Stripe, Shopify, GTM — tout réconcilié' },
        ].map((c) => (
          <div class="sa-card">
            <div class="cap-icon">{c.i}</div>
            <div class="cap-title">{c.t}</div>
            <div class="cap-desc">{c.d}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── AI Outputs ──────────────────────────────────────────────────── -->
  <section class="outputs sa-fade">
    <div class="container">
      <div class="section-head">
        <div class="s-badge">Ce que tu reçois</div>
        <h2 class="section-title" style="margin-bottom:16px">Pas que du texte.<br />Graphiques, tableaux, PDFs.</h2>
        <p class="section-sub" style="max-width:540px;margin:0 auto">Chaque réponse vient avec les visuels et les données qu’il faut. Auto-générés, exportables, partageables.</p>
      </div>
      <div class="outputs-grid">
        <div class="out-card">
          <div class="out-head"><span class="out-icon">◴</span><span class="out-title">Graphiques live</span></div>
          <div class="out-viz">
            <div class="out-chart">
              <div class="out-bar" style="height:48%"></div>
              <div class="out-bar" style="height:62%"></div>
              <div class="out-bar" style="height:54%"></div>
              <div class="out-bar" style="height:70%"></div>
              <div class="out-bar" style="height:65%"></div>
              <div class="out-bar warn" style="height:34%"></div>
              <div class="out-bar warn" style="height:28%"></div>
              <span class="out-chart-anomaly">⚠ anomalie</span>
            </div>
          </div>
          <div class="out-caption">Courbes, barres, comparaisons, rendu auto avec mise en évidence des anomalies.</div>
        </div>

        <div class="out-card">
          <div class="out-head"><span class="out-icon">◫</span><span class="out-title">Tableaux intelligents</span></div>
          <div class="out-viz">
            <table class="out-table">
              <thead><tr><th>Campagne</th><th style="text-align:right">CPA</th><th style="text-align:right">Δ</th></tr></thead>
              <tbody>
                <tr><td>Brand</td><td class="v">8,20 €</td><td class="g">−12%</td></tr>
                <tr><td>Retarget</td><td class="v">18,50 €</td><td class="g">−4%</td></tr>
                <tr><td>Prospect</td><td class="v">31,20 €</td><td class="b">+34%</td></tr>
              </tbody>
            </table>
          </div>
          <div class="out-caption">Comparaisons côte à côte avec écarts, classées par importance.</div>
        </div>

        <div class="out-card">
          <div class="out-head"><span class="out-icon">◑</span><span class="out-title">Analyse de cause</span></div>
          <div class="out-viz">
            <div class="out-insight">
              <div class="ins-row"><span>↓</span>Trafic mobile −34% (iOS 18 ATT)</div>
              <div class="ins-row warn"><span>⚠</span>Abandon checkout étape 2 +12%</div>
              <div class="ins-row"><span>✕</span>Tag GTM manquant sur /checkout</div>
              <div class="ins-row ok"><span>✓</span>2 hypothèses sur 3 confirmées</div>
            </div>
          </div>
          <div class="out-caption">Analyse structurée, causes classées par preuves et impact.</div>
        </div>

        <div class="out-card">
          <div class="out-head"><span class="out-icon">▤</span><span class="out-title">Rapports PDF</span></div>
          <div class="out-viz">
            <div class="out-pdf">
              <div class="pdf-h"></div>
              <div class="pdf-l"></div>
              <div class="pdf-l short"></div>
              <div class="pdf-chart"></div>
              <div class="pdf-l shorter"></div>
            </div>
          </div>
          <div class="out-caption">Rapports mensuels white-label, envoyés auto le 1ᵉʳ avec synthèse exécutive.</div>
        </div>

        <div class="out-card">
          <div class="out-head"><span class="out-icon">→</span><span class="out-title">Actions priorisées</span></div>
          <div class="out-viz">
            <div class="out-actions">
              <div class="act-row"><span class="act-num">1</span>Corriger le tag GTM /checkout<span class="act-prio high">Haute</span></div>
              <div class="act-row"><span class="act-num">2</span>A/B tester étape 2<span class="act-prio">Moy.</span></div>
              <div class="act-row"><span class="act-num">3</span>Revoir enchères iOS<span class="act-prio">Moy.</span></div>
              <div class="act-row"><span class="act-num">4</span>Activer Enhanced Conv.<span class="act-prio">Faible</span></div>
            </div>
          </div>
          <div class="out-caption">Classées, scorées, prêtes à exécuter, avec impact attendu par action.</div>
        </div>

        <div class="out-card">
          <div class="out-head"><span class="out-icon">◧</span><span class="out-title">Dashboards custom</span></div>
          <div class="out-viz">
            <div class="out-kpis">
              <div class="out-kpi"><div class="kl">CVR</div><div class="kv">2,4%</div><div class="kd b">−0,3%</div></div>
              <div class="out-kpi"><div class="kl">CPA</div><div class="kv">24,5 €</div><div class="kd b">+13%</div></div>
              <div class="out-kpi"><div class="kl">ROAS</div><div class="kv">3,2x</div><div class="kd g">+8%</div></div>
              <div class="out-kpi"><div class="kl">Santé</div><div class="kv">87</div><div class="kd g">Bon</div></div>
            </div>
          </div>
          <div class="out-caption">KPIs épinglés et vues sauvegardées, ta routine quotidienne en un seul endroit.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Features ────────────────────────────────────────────────────── -->
  <section class="features sa-fade" id="features">
    <div class="container">
      <div class="section-head">
        <div class="s-badge">Fonctionnalités</div>
        <h2 class="section-title">Tout ce dont tu as besoin.<br />Rien de plus.</h2>
      </div>

      <!-- Feature 01, Ask -->
      <div class="feat-row">
        <div class="feat-ui">
          <div class="chat-window compact">
            <div class="chat-chrome">
              <div class="chat-traffic"><span style="background:#FF5F57"></span><span style="background:#FEBC2E"></span><span style="background:#28C840"></span></div>
              <div class="chat-urlbar"><span>smartanalyst.app</span></div>
              <div class="chat-pills"><span class="chat-pill on">GA4</span><span class="chat-pill on">Meta</span><span class="chat-pill on">GTM</span><span class="chat-pill">+4</span></div>
            </div>
            <div class="chat-body">
              <div class="chat-user"><div class="chat-bubble user">« Pourquoi notre taux de conversion a baissé cette semaine ? »</div></div>
              <div class="chat-response visible">
                <div class="chat-label">Analyse, 3 causes identifiées</div>
                <div class="chat-causes">
                  <div class="cause"><span class="cause-icon red">↓</span><div><strong>Trafic mobile −34%</strong>, fenêtre d’attribution iOS 18</div></div>
                  <div class="cause"><span class="cause-icon orange">↑</span><div><strong>Abandon checkout +12%</strong>, friction étape 2 depuis mardi</div></div>
                  <div class="cause"><span class="cause-icon red">⚠</span><div><strong>Tag GTM manquant sur /checkout</strong>, depuis le 18 nov.</div></div>
                </div>
                <div class="chat-actions">
                  <span class="chat-action">Corriger le tag GTM →</span>
                  <span class="chat-action">A/B tester étape 2</span>
                  <span class="chat-action">Revoir enchères iOS</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="feat-copy">
          <div class="feat-eyebrow">01, Demander</div>
          <h3 class="feat-title">Pose n’importe quelle question à tes données.</h3>
          <p class="feat-desc">Pas de SQL. Pas d’analyste. Pas de ticket à ouvrir. Tu poses la question. SmartAnalyst comprend ton contexte marketing et te renvoie des réponses structurées, sourcées, avec causes, comparaisons et prochaines étapes.</p>
          <ul class="feat-bullets">
            <li>Langage naturel, aucune syntaxe à apprendre</li>
            <li>Réponses cross-sources en quelques secondes</li>
            <li>Sources citées et niveaux de confiance</li>
          </ul>
        </div>
      </div>

      <!-- Feature 02, Detect -->
      <div class="feat-row reverse">
        <div class="feat-ui">
          <div class="watch-card">
            <div class="watch-head">
              <span class="watch-eyebrow">Veille · Nouvelle</span>
              <span class="watch-tag">3 actives</span>
            </div>
            <div class="watch-input">
              <span class="watch-prompt">Décris ta veille en langage naturel.</span>
              <div class="watch-typed">« Préviens-moi quand mon ROAS Meta descend sous 2 pendant 3 jours d’affilée »</div>
            </div>
            <div class="watch-parsed">
              <div class="watch-parsed-label">Compris par l’IA</div>
              <div class="watch-chips">
                <span class="watch-chip"><span class="watch-chip-k">Métrique</span>ROAS Meta</span>
                <span class="watch-chip"><span class="watch-chip-k">Seuil</span>&lt; 2</span>
                <span class="watch-chip"><span class="watch-chip-k">Fenêtre</span>3 jours consécutifs</span>
              </div>
            </div>
            <div class="watch-list">
              <div class="watch-row">
                <span class="watch-dot calm"></span>
                <span class="watch-row-title">ROAS Meta &lt; 2</span>
                <span class="watch-row-state">Calme · ROAS actuel 2,8</span>
              </div>
              <div class="watch-row">
                <span class="watch-dot fired"></span>
                <span class="watch-row-title">CPA Google &gt; 30 €</span>
                <span class="watch-row-state">Déclenchée il y a 12 min</span>
              </div>
              <div class="watch-row">
                <span class="watch-dot calm"></span>
                <span class="watch-row-title">Sessions iOS &lt; 1 000 / jour</span>
                <span class="watch-row-state">Calme · 1 480 hier</span>
              </div>
            </div>
          </div>
        </div>
        <div class="feat-copy">
          <div class="feat-eyebrow">02, Surveiller</div>
          <h3 class="feat-title">Tes veilles, écrites comme tu parles.</h3>
          <p class="feat-desc">Tu décris la condition que tu veux surveiller en français. SmartAnalyst la traduit en règle exécutable, la valide contre ta vraie liste de métriques, et te prévient seulement quand elle se déclenche vraiment.</p>
          <ul class="feat-bullets">
            <li>Langage naturel, l’IA mappe vers la bonne métrique canonique</li>
            <li>Validation côté serveur (modèle structuré, pas d’hallucination)</li>
            <li>Notification in-app + email dès que la condition est atteinte</li>
          </ul>
        </div>
      </div>

      <!-- Feature 03, Connect -->
      <div class="feat-row">
        <div class="feat-ui">
          <div class="conn-grid">
            {[
              { n:'Google Ads', k:'GADS', logo:'google_ads', ok:true, col:'#4285F4' },
              { n:'Meta Ads',   k:'META', logo:'facebook',   ok:true, col:'#1877F2' },
              { n:'GA4',        k:'GA4',  logo:'ga4',        ok:true, col:'#F9AB00' },
              { n:'Shopify',    k:'SHOP', logo:'shopify',    ok:true, col:'#96BF48' },
              { n:'GTM',        k:'GTM',  ok:true, col:'#4285F4' },
              { n:'CRM',        k:'CRM',  ok:false, col:'#666' },
              { n:'Consent CMP',k:'CMP',  ok:false, col:'#666' },
              { n:'Server-side',k:'SST',  ok:false, col:'#666' },
            ].map(c => (
              <div class="sa-conn">
                <div class={`conn-badge ${c.ok ? 'on' : 'off'} ${c.logo ? 'has-logo' : ''}`} style={`--c:${c.col};--cbg:${c.col}18;--cbd:${c.col}33`}>
                  {c.logo ? <img src={`/connectors/${c.logo}.png`} alt={c.n} loading="lazy" decoding="async" /> : c.k}
                </div>
                <div class={`conn-name ${c.ok ? 'on' : 'off'}`}>{c.n}</div>
                <div class={`conn-status ${c.ok ? 'on' : 'off'}`}>{c.ok ? '● actif' : '○ config →'}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="feat-copy">
          <div class="feat-eyebrow">03, Connecter</div>
          <h3 class="feat-title">Tout ton stack, unifié.</h3>
          <p class="feat-desc">Intégrations en un clic avec tout ce que ton équipe utilise déjà. Pas de ressource tech. Pas d’ETL. De zéro à insights en quelques minutes, pas en mois.</p>
          <ul class="feat-bullets">
            <li>Google Ads, Meta, GA4, Shopify, CRM</li>
            <li>GTM, CMP, tracking server-side</li>
            <li>Connecteurs custom sur demande</li>
          </ul>
        </div>
      </div>

      <!-- Feature 04, Monitor -->
      <div class="feat-row reverse">
        <div class="feat-ui">
          <div class="health">
            <div class="health-top">
              <div class="health-label">Score de santé des données</div>
              <div class="health-score">
                <span class="health-num">87</span><span class="health-of">/100</span>
                <span class="health-good">● Bon</span>
              </div>
              <div class="health-bar"><div class="health-bar-fill"></div></div>
            </div>
            <div class="health-checks">
              <div class="hcheck ok"><span>✓</span>Events GTM remontent correctement</div>
              <div class="hcheck ok"><span>✓</span>Consent mode v2 actif</div>
              <div class="hcheck warn"><span>⚠</span>Enhanced Conversions partiel</div>
              <div class="hcheck err"><span>✕</span>Pixel server-side non connecté</div>
              <div class="hcheck ok"><span>✓</span>Data layer : 18/20 events valides</div>
            </div>
          </div>
        </div>
        <div class="feat-copy">
          <div class="feat-eyebrow">04, Monitorer</div>
          <h3 class="feat-title">Des données vraiment fiables.</h3>
          <p class="feat-desc">Tes analytics ne valent que ce que vaut ton tracking. SmartAnalyst monitore la qualité de tes données en continu, santé GTM, conformité consent mode, précision des events et couverture d’attribution.</p>
          <ul class="feat-bullets">
            <li>Score de santé tracking en temps réel</li>
            <li>Audit couverture events et data layer</li>
            <li>Consent mode v2 et trous d’attribution</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SaaS Preview ────────────────────────────────────────────────── -->
  <section class="saas sa-fade">
    <div class="container">
      <div class="section-head">
        <div class="s-badge">Le produit</div>
        <h2 class="section-title" style="margin-bottom:16px">Une nouvelle façon de travailler avec tes données.</h2>
        <p class="section-sub" style="max-width:500px;margin:0 auto">
          Épuré. Focalisé. Décidé. Conçu pour les équipes marketing qui veulent des réponses, pas de la config.
        </p>
      </div>
      <div class="app-frame">
        <div class="app-chrome">
          <div class="chat-traffic"><span style="background:#FF5F57"></span><span style="background:#FEBC2E"></span><span style="background:#28C840"></span></div>
          <div class="app-url"><span>app.smartanalyst.io/workspace</span></div>
        </div>
        <div class="app-body">
          <aside class="app-sidebar">
            <div class="app-brand">
              <BrandMark size={24} />
              <span class="brand-name" style="font-size:14px">SmartAnalyst</span>
            </div>
            <div class="app-nav">
              <button class="snav active" data-tab="brief"><span class="snav-icon">◐</span>Mon point du jour</button>
              <button class="snav" data-tab="assistant"><span class="snav-icon">✦</span>Assistant</button>
              <button class="snav" data-tab="veille"><span class="snav-icon">◎</span>Veille<span class="snav-badge">3</span></button>
