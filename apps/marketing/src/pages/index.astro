---
import DarkBase from '../layouts/DarkBase.astro';
---
<DarkBase
  title="home"
  description="Ask any question about your marketing performance. Get structured answers with root causes, evidence and recommended actions — instantly."
>
  <!-- ─── Nav ─────────────────────────────────────────────────────────── -->
  <nav class="nav" id="nav">
    <div class="nav-inner">
      <a href="/" class="brand">
        <span class="brand-mark"></span>
        <span class="brand-name">SmartAnalyst</span>
      </a>
      <div class="nav-links">
        <a href="#features">Features</a>
        <a href="#use-cases">Use cases</a>
        <a href="/pricing">Pricing</a>
      </div>
      <a href="#cta" class="btn btn-primary btn-sm">Request early access</a>
    </div>
  </nav>

  <!-- ─── Hero ────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="glow hero-glow"></div>
    <div class="hero-inner">
      <div class="hero-copy">
        <div class="s-badge">Marketing Intelligence OS</div>
        <h1>
          Your marketing data,<br />
          <span class="gradient-text">finally understood.</span>
        </h1>
        <p class="hero-lead">
          Ask any question about your marketing performance.<br />
          Get structured answers with root causes, evidence<br />
          and recommended actions — instantly.
        </p>
        <div class="hero-ctas">
          <a href="#cta" class="btn btn-primary">Request early access</a>
          <a href="#features" class="btn">See how it works ↓</a>
        </div>
        <div class="hero-connects">
          <span class="hero-connects-label">Connects with:</span>
          {['Google Ads','Meta','GA4','Shopify','GTM','CRM','CMP','Server-side'].map((s) => (
            <span class="conn-pill">{s}</span>
          ))}
        </div>
      </div>
      <div class="hero-chat-wrap">
        <div class="chat-window" id="hero-chat">
          <div class="chat-chrome">
            <div class="chat-traffic">
              <span style="background:#FF5F57"></span>
              <span style="background:#FEBC2E"></span>
              <span style="background:#28C840"></span>
            </div>
            <div class="chat-urlbar"><span>smartanalyst.app</span></div>
            <div class="chat-pills">
              <span class="chat-pill on">GA4</span>
              <span class="chat-pill on">Meta</span>
              <span class="chat-pill on">GTM</span>
              <span class="chat-pill">+4</span>
            </div>
          </div>
          <div class="chat-body">
            <div class="chat-user">
              <div class="chat-bubble user">"Why did our conversion rate drop this week?"</div>
            </div>
            <div class="chat-typing" id="chat-typing" hidden>
              <span></span><span></span><span></span>
            </div>
            <div class="chat-response" id="chat-response" hidden>
              <div class="chat-label">Analysis — 3 causes identified</div>
              <div class="chat-causes">
                <div class="cause"><span class="cause-icon red">↓</span><div><strong>Mobile traffic −34%</strong> — iOS 18 attribution window change</div></div>
                <div class="cause"><span class="cause-icon orange">↑</span><div><strong>Checkout abandonment +12%</strong> — Step 2 friction since Tuesday</div></div>
                <div class="cause"><span class="cause-icon red">⚠</span><div><strong>GTM tag missing on /checkout</strong> — Active since Nov 18</div></div>
              </div>
              <div class="chat-actions">
                <span class="chat-action">Fix GTM tag →</span>
                <span class="chat-action">A/B test step 2</span>
                <span class="chat-action">Review iOS bids</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Problem ─────────────────────────────────────────────────────── -->
  <section class="problem sa-fade">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">
          Your team runs on 12+ tools.<br />Gets answers from none of them.
        </h2>
        <p class="section-sub">Every morning, same chaos. Same unanswered question: "Why?"</p>
      </div>
      <div class="ba">
        <div class="ba-before">
          <div class="ba-label">Before — your current stack</div>
          <div class="ba-tools">
            {['GA4','Google Tag Manager','Meta Ads','Google Ads','Shopify','CRM','Looker Studio','Hotjar','CMP','Search Console','Spreadsheets','Klaviyo'].map(t => (
              <span class="tool-pill">{t}</span>
            ))}
            <span class="tool-pill ghost">+ 5 more</span>
          </div>
          <ul class="ba-points red">
            <li>No unified view</li>
            <li>Manual analysis takes days</li>
            <li>Questions without answers</li>
            <li>3,000 KPIs — 0 priorities</li>
          </ul>
        </div>
        <div class="ba-arrow"><span>→</span></div>
        <div class="ba-after">
          <div class="ba-label ba-label-cyan">After — SmartAnalyst</div>
          <div class="ba-quote">
            <div class="ba-quote-head"><span class="dot"></span><strong>SmartAnalyst</strong></div>
            <div class="ba-quote-q">"Why did our conversion rate drop?"</div>
            <div class="ba-quote-a">→ 3 causes found. 3 actions ready.</div>
          </div>
          <ul class="ba-points green">
            <li>Single source of truth</li>
            <li>Instant analysis, real-time</li>
            <li>Clear causes + priorities</li>
            <li>Recommended next actions</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Product Promise ─────────────────────────────────────────────── -->
  <section class="promise sa-fade">
    <div class="glow" style="width:700px;height:700px;top:50%;left:50%;transform:translate(-50%,-50%);opacity:0.6"></div>
    <div class="container">
      <div class="section-head">
        <div class="s-badge">The product</div>
        <h2 class="section-title">Your AI marketing data analyst.</h2>
        <p class="section-sub" style="max-width:490px;margin:0 auto">
          Not a dashboard. Not a BI tool. An intelligent layer that understands your business and speaks in plain language.
        </p>
      </div>
      <div class="cap-grid">
        {[
          { i:'◑', t:'Understand performance',   d:'Instant context on any metric, any timeframe or channel' },
          { i:'⚡', t:'Identify anomalies',       d:'Detected automatically, with full root cause analysis' },
          { i:'◎', t:'Explain variations',       d:'Why things changed, backed by cross-source evidence' },
          { i:'→', t:'Prioritize actions',       d:'Ranked recommendations, scored by expected impact' },
          { i:'◈', t:'Track impact',             d:'Before/after measurement on every change you make' },
          { i:'◉', t:'Optimize your data stack', d:'GTM, consent mode, attribution — all continuously monitored' },
        ].map((c) => (
          <div class="sa-card">
            <div class="cap-icon">{c.i}</div>
            <div class="cap-title">{c.t}</div>
            <div class="cap-desc">{c.d}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Features ────────────────────────────────────────────────────── -->
  <section class="features sa-fade" id="features">
    <div class="container">
      <div class="section-head">
        <div class="s-badge">Features</div>
        <h2 class="section-title">Everything you need.<br />Nothing you don't.</h2>
      </div>

      <!-- Feature 01 — Ask -->
      <div class="feat-row">
        <div class="feat-ui">
          <div class="chat-window compact">
            <div class="chat-chrome">
              <div class="chat-traffic"><span style="background:#FF5F57"></span><span style="background:#FEBC2E"></span><span style="background:#28C840"></span></div>
              <div class="chat-urlbar"><span>smartanalyst.app</span></div>
              <div class="chat-pills"><span class="chat-pill on">GA4</span><span class="chat-pill on">Meta</span><span class="chat-pill on">GTM</span><span class="chat-pill">+4</span></div>
            </div>
            <div class="chat-body">
              <div class="chat-user"><div class="chat-bubble user">"Why did our conversion rate drop this week?"</div></div>
              <div class="chat-response visible">
                <div class="chat-label">Analysis — 3 causes identified</div>
                <div class="chat-causes">
                  <div class="cause"><span class="cause-icon red">↓</span><div><strong>Mobile traffic −34%</strong> — iOS 18 attribution window change</div></div>
                  <div class="cause"><span class="cause-icon orange">↑</span><div><strong>Checkout abandonment +12%</strong> — Step 2 friction since Tuesday</div></div>
                  <div class="cause"><span class="cause-icon red">⚠</span><div><strong>GTM tag missing on /checkout</strong> — Active since Nov 18</div></div>
                </div>
                <div class="chat-actions">
                  <span class="chat-action">Fix GTM tag →</span>
                  <span class="chat-action">A/B test step 2</span>
                  <span class="chat-action">Review iOS bids</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="feat-copy">
          <div class="feat-eyebrow">01 — Ask</div>
          <h3 class="feat-title">Ask your data anything.</h3>
          <p class="feat-desc">No SQL. No analyst. No ticket queue. Just ask. SmartAnalyst understands your marketing context and returns structured, evidence-backed answers with causes, comparisons and next steps.</p>
          <ul class="feat-bullets">
            <li>Natural language — no query syntax needed</li>
            <li>Cross-source answers in seconds</li>
            <li>Cited sources and confidence levels</li>
          </ul>
        </div>
      </div>

      <!-- Feature 02 — Detect -->
      <div class="feat-row reverse">
        <div class="feat-ui">
          <div class="alert-feed">
            <div class="alert-head">
              <span>Alerts — Last 24h</span>
              <span class="alert-tag-crit">3 critical</span>
            </div>
            <div class="alert-item">
              <span class="alert-dot crit"></span>
              <div class="alert-body"><strong>CPA spiked +34%</strong><span>€31.20 vs €23.50 avg</span></div>
              <div class="alert-meta"><span class="alert-src">Google Ads</span><span class="alert-time">12m ago</span></div>
            </div>
            <div class="alert-item">
              <span class="alert-dot warn"></span>
              <div class="alert-body"><strong>Checkout CVR ↓12%</strong><span>Step 2 abandonment: 44%</span></div>
              <div class="alert-meta"><span class="alert-src">Site</span><span class="alert-time">1h ago</span></div>
            </div>
            <div class="alert-item last">
              <span class="alert-dot crit"></span>
              <div class="alert-body"><strong>GTM tag missing</strong><span>/checkout since Nov 18</span></div>
              <div class="alert-meta"><span class="alert-src">Tracking</span><span class="alert-time">3d ago</span></div>
            </div>
          </div>
        </div>
        <div class="feat-copy">
          <div class="feat-eyebrow">02 — Detect</div>
          <h3 class="feat-title">Know before it hurts.</h3>
          <p class="feat-desc">CPA spike, conversion drop, tracking failure — SmartAnalyst monitors your entire stack 24/7 and surfaces anomalies the moment they appear, with full context and severity ranking.</p>
          <ul class="feat-bullets">
            <li>CPA, CVR, ROAS and volume monitoring</li>
            <li>Tracking integrity and consent alerts</li>
            <li>Smart severity and impact scoring</li>
          </ul>
        </div>
      </div>

      <!-- Feature 03 — Connect -->
      <div class="feat-row">
        <div class="feat-ui">
          <div class="conn-grid">
            {[
              { n:'Google Ads', k:'GADS', ok:true, col:'#4285F4' },
              { n:'Meta Ads',   k:'META', ok:true, col:'#1877F2' },
              { n:'GA4',        k:'GA4',  ok:true, col:'#F9AB00' },
              { n:'Shopify',    k:'SHOP', ok:true, col:'#96BF48' },
              { n:'GTM',        k:'GTM',  ok:true, col:'#4285F4' },
              { n:'CRM',        k:'CRM',  ok:false, col:'#666' },
              { n:'Consent CMP',k:'CMP',  ok:false, col:'#666' },
              { n:'Server-side',k:'SST',  ok:false, col:'#666' },
            ].map(c => (
              <div class="sa-conn">
                <div class={`conn-badge ${c.ok ? 'on' : 'off'}`} style={`--c:${c.col};--cbg:${c.col}18;--cbd:${c.col}33`}>{c.k}</div>
                <div class={`conn-name ${c.ok ? 'on' : 'off'}`}>{c.n}</div>
                <div class={`conn-status ${c.ok ? 'on' : 'off'}`}>{c.ok ? '● live' : '○ setup →'}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="feat-copy">
          <div class="feat-eyebrow">03 — Connect</div>
          <h3 class="feat-title">Your entire stack, unified.</h3>
          <p class="feat-desc">One-click integrations with everything your marketing team already uses. No engineering resources. No ETL pipelines. Go from zero to insights in minutes, not months.</p>
          <ul class="feat-bullets">
            <li>Google Ads, Meta, GA4, Shopify, CRM</li>
            <li>GTM, CMP, server-side tracking</li>
            <li>Custom data source connectors</li>
          </ul>
        </div>
      </div>

      <!-- Feature 04 — Monitor -->
      <div class="feat-row reverse">
        <div class="feat-ui">
          <div class="health">
            <div class="health-top">
              <div class="health-label">Data health score</div>
              <div class="health-score">
                <span class="health-num">87</span><span class="health-of">/100</span>
                <span class="health-good">● Good</span>
              </div>
              <div class="health-bar"><div class="health-bar-fill"></div></div>
            </div>
            <div class="health-checks">
              <div class="hcheck ok"><span>✓</span>GTM events firing correctly</div>
              <div class="hcheck ok"><span>✓</span>Consent mode v2 active</div>
              <div class="hcheck warn"><span>⚠</span>Enhanced Conversions partial</div>
              <div class="hcheck err"><span>✕</span>Server-side pixel not connected</div>
              <div class="hcheck ok"><span>✓</span>Data layer: 18/20 events valid</div>
            </div>
          </div>
        </div>
        <div class="feat-copy">
          <div class="feat-eyebrow">04 — Monitor</div>
          <h3 class="feat-title">Data you can actually trust.</h3>
          <p class="feat-desc">Your analytics are only as good as your tracking. SmartAnalyst continuously monitors data quality — GTM health, consent mode compliance, event accuracy and attribution coverage.</p>
          <ul class="feat-bullets">
            <li>Real-time tracking health score</li>
            <li>Event coverage and data layer audits</li>
            <li>Consent mode v2 and attribution gaps</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SaaS Preview ────────────────────────────────────────────────── -->
  <section class="saas sa-fade">
    <div class="container">
      <div class="section-head">
        <div class="s-badge">The product</div>
        <h2 class="section-title" style="margin-bottom:16px">A new way to work with your data.</h2>
        <p class="section-sub" style="max-width:500px;margin:0 auto">
          Clean. Focused. Opinionated. Built for marketing teams who need answers, not configuration.
        </p>
      </div>
      <div class="app-frame">
        <div class="app-chrome">
          <div class="chat-traffic"><span style="background:#FF5F57"></span><span style="background:#FEBC2E"></span><span style="background:#28C840"></span></div>
          <div class="app-url"><span>app.smartanalyst.io/workspace</span></div>
        </div>
        <div class="app-body">
          <aside class="app-sidebar">
            <div class="app-brand">
              <span class="brand-mark" style="width:24px;height:24px;border-radius:6px"></span>
              <span class="brand-name" style="font-size:14px">SmartAnalyst</span>
            </div>
            <div class="app-nav">
              <button class="snav active" data-tab="dash"><span class="snav-icon">◫</span>Dashboard</button>
              <button class="snav" data-tab="ask"><span class="snav-icon">◉</span>Ask AI</button>
              <button class="snav" data-tab="alerts"><span class="snav-icon">⚠</span>Anomalies<span class="snav-badge">3</span></button>
              <button class="snav" data-tab="conn"><span class="snav-icon">◈</span>Connectors</button>
              <button class="snav" data-tab="health"><span class="snav-icon">◑</span>Data Health</button>
              <button class="snav" data-tab="actions"><span class="snav-icon">→</span>Actions</button>
            </div>
            <div class="app-user">john@acme.com</div>
          </aside>
          <main class="app-main">
            <div class="app-header">
              <span class="app-title">Dashboard</span>
              <div class="app-header-ctas">
                <span class="app-pill">Last 7 days ▾</span>
                <span class="app-pill blue">Ask AI →</span>
              </div>
            </div>
            <div class="kpis">
              <div class="kpi">
                <div class="kpi-l">Conversion Rate</div>
                <div class="kpi-v">2.4%</div>
                <div class="kpi-d red">−0.3% vs prev</div>
              </div>
              <div class="kpi">
                <div class="kpi-l">CPA — Google</div>
                <div class="kpi-v">€24.50</div>
                <div class="kpi-d red">+€3.20 vs prev</div>
              </div>
              <div class="kpi">
                <div class="kpi-l">Sessions</div>
                <div class="kpi-v">48,234</div>
                <div class="kpi-d green">+8% vs prev</div>
              </div>
              <div class="kpi accent">
                <div class="kpi-l">Data Health</div>
                <div class="kpi-v">87/100</div>
                <div class="kpi-d blue">Good →</div>
              </div>
            </div>
            <div class="chart">
              <div class="chart-label">Performance — 7 days</div>
              <div class="chart-bars">
                {[40,55,45,62,56,48,70].map(h => (
                  <div class="bar-group">
                    <div class="bar bar-blue" style={`height:${h}%`}></div>
                    <div class="bar bar-cyan" style={`height:${h * 0.55}%`}></div>
                  </div>
                ))}
              </div>
            </div>
            <div class="panels">
              <div class="panel">
                <div class="panel-title">Latest insights</div>
                <div class="panel-row"><span class="dot red"></span><span>CVR dropped 12% — checkout issue</span><span class="t">2h</span></div>
                <div class="panel-row"><span class="dot orange"></span><span>Meta CPA up 18% this week</span><span class="t">5h</span></div>
                <div class="panel-row"><span class="dot gray"></span><span>iOS traffic down — review attribution</span><span class="t">1d</span></div>
              </div>
              <div class="panel panel-blue">
                <div class="panel-title">Recommended actions</div>
                <div class="panel-row"><span class="num">1.</span>Fix GTM tag on /checkout</div>
                <div class="panel-row"><span class="num">2.</span>A/B test checkout step 2</div>
                <div class="panel-row"><span class="num">3.</span>Review iOS bid strategy</div>
                <div class="panel-row"><span class="num">4.</span>Enable Enhanced Conversions</div>
              </div>
            </div>
          </main>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Use Cases ───────────────────────────────────────────────────── -->
  <section class="usecases sa-fade" id="use-cases">
    <div class="container">
      <div class="section-head">
        <div class="s-badge">Use cases</div>
        <h2 class="section-title" style="margin-bottom:16px">Ask what actually matters.</h2>
        <p class="section-sub">Real questions. Structured answers. No dashboard configuration required.</p>
      </div>
      <div class="uc-grid">
        {[
          'Why did my leads drop?',
          'Which campaign is wasting budget?',
          'Is my tracking reliable?',
          'What should I optimize this week?',
          'Which audience deserves more investment?',
          'What data projects should I prioritize?',
        ].map(q => (
          <div class="sa-feat uc-card">
            <div class="uc-icon">→</div>
            <span class="uc-q">"{q}"</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Trust ───────────────────────────────────────────────────────── -->
  <section class="trust sa-fade">
    <div class="glow" style="width:600px;height:600px;bottom:-200px;right:-80px;opacity:0.45"></div>
    <div class="container" style="position:relative;z-index:1">
      <div class="section-head">
        <h2 class="section-title" style="margin-bottom:16px">Built to be trusted.</h2>
        <p class="section-sub">A serious platform for serious teams.</p>
      </div>
      <div class="trust-grid">
        {[
          { i:'◎', t:'Built for marketing teams', d:'Designed around how marketers work — not data engineers.' },
          { i:'◑', t:'Privacy-conscious',         d:'Consent-aware, GDPR-friendly, privacy-first by design.' },
          { i:'◈', t:'Decision-first analytics',  d:'Every output drives a clear, actionable next step.' },
          { i:'◉', t:'Modern stack compatible',   d:'Server-side, cookieless, enhanced conversions — all supported.' },
          { i:'→', t:'Designed for performance',  d:'Real-time signals, fast answers, low-latency dashboards.' },
        ].map(p => (
          <div class="sa-card trust-card">
            <div class="cap-icon">{p.i}</div>
            <div class="cap-title">{p.t}</div>
            <div class="cap-desc">{p.d}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Final CTA ───────────────────────────────────────────────────── -->
  <section class="final-cta" id="cta">
    <div class="glow" style="width:960px;height:720px;top:50%;left:50%;transform:translate(-50%,-50%)"></div>
    <div class="cta-inner">
      <h2 class="cta-title">
        Stop reading dashboards.<br />
        <span class="gradient-text">Start asking your data.</span>
      </h2>
      <p class="cta-sub">
        Join marketing teams replacing their dashboard routine<br />with a single question.
      </p>
      <a href="mailto:contact@smartanalyst.io?subject=Early%20access" class="btn btn-primary" style="font-size:16px;padding:14px 36px">Request early access</a>
      <div class="cta-fine">
        Free early access · No credit card required · Setup in minutes
      </div>
    </div>
  </section>

  <!-- ─── Footer ──────────────────────────────────────────────────────── -->
  <footer class="footer">
    <div class="footer-inner">
      <a href="/" class="brand">
        <span class="brand-mark" style="width:22px;height:22px;border-radius:5px"></span>
        <span class="brand-name" style="font-size:14px">SmartAnalyst</span>
      </a>
      <div class="footer-copy">© {new Date().getFullYear()} SmartAnalyst. All rights reserved.</div>
      <div class="footer-links">
        <a href="/securite">Privacy</a>
        <a href="/securite">Terms</a>
        <a href="mailto:contact@smartanalyst.io">Contact</a>
      </div>
    </div>
  </footer>

  <!-- ─── Interactivity ──────────────────────────────────────────────── -->
  <script is:inline>
    // Nav scroll effect
    const nav = document.getElementById('nav');
    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 30);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Reveal-on-scroll
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add('visible'); }),
      { threshold: 0.08 },
    );
    document.querySelectorAll('.sa-fade').forEach((el) => io.observe(el));

    // Hero chat animation: user → typing dots (900ms) → response (2400ms)
    const typing = document.getElementById('chat-typing');
    const response = document.getElementById('chat-response');
    if (typing && response) {
      setTimeout(() => { typing.hidden = false; }, 900);
      setTimeout(() => { typing.hidden = true; response.hidden = false; }, 2400);
    }

    // SaaS preview sidebar tabs (cosmetic — just switches active state + title)
    const tabs = document.querySelectorAll('.snav');
    const titleEl = document.querySelector('.app-title');
    const labels = { dash:'Dashboard', ask:'Ask AI', alerts:'Anomalies', conn:'Connectors', health:'Data Health', actions:'Actions' };
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => x.classList.remove('active'));
      t.classList.add('active');
      const k = t.dataset.tab;
      if (titleEl && labels[k]) titleEl.textContent = labels[k];
    }));
  </script>

