---
// Root redirect: picks the user's preferred locale from the browser, then
// navigates to /en or /fr. Static hosting (Hostinger) can't do server-side
// redirects, so we use JS + meta-refresh as a no-JS fallback.
//
// IMPORTANT: keep this page tiny, it ships HTML that the user briefly sees.
const defaultLocale = 'en';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SmartAnalyst</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://smartanalyst.io/en" />
    <link rel="alternate" hreflang="en" href="https://smartanalyst.io/en" />
    <link rel="alternate" hreflang="fr" href="https://smartanalyst.io/fr" />
    <link rel="alternate" hreflang="x-default" href="https://smartanalyst.io/en" />
    <meta http-equiv="refresh" content={`0; url=/${defaultLocale}/`} />
    <script is:inline>
      (() => {
        const supported = ['en', 'fr'];
        const fallback = 'en';
        const pick = (() => {
          const langs = (navigator.languages && navigator.languages.length
            ? navigator.languages
            : [navigator.language || ''])
            .map((l) => (l || '').toLowerCase().split('-')[0]);
          for (const l of langs) if (supported.includes(l)) return l;
          return fallback;
        })();
        window.location.replace('/' + pick + '/');
      })();
    </script>
    <style>
      body { background: #06060B; color: #74748C; font-family: system-ui, sans-serif; }
      .wrap { display: flex; align-items: center; justify-content: center; min-height: 100vh; }
      a { color: #3D82FF; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <p>Redirecting… <a href="/en/">English</a> · <a href="/fr/">Français</a></p>
    </div>
  </body>
</html>
