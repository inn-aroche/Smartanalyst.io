---
import { LOGO_ICONS } from '../data/connector-logos.js';

const { name, size = 22, withLabel = true } = Astro.props;
const icon = LOGO_ICONS[name];
if (!icon) throw new Error(`LogoIcon: unknown name "${name}"`);

const monoFontSize = icon.kind === 'mono' && icon.mono.length === 1
  ? Math.round(size * 0.5)
  : Math.round(size * 0.38);
---
{icon.kind === 'svg' ? (
  <span class="logo-icon-wrap">
    <span class="logo-icon-tile" style={`width:${size}px;height:${size}px;color:${icon.hex}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true" width={size} height={size} fill="currentColor">
        <path d={icon.path} />
      </svg>
    </span>
    {withLabel && <span class="logo-icon-label">{icon.label}</span>}
  </span>
) : (
  <span class="logo-icon-wrap">
    <span
      class="logo-icon-mono"
      style={`background:${icon.bg};color:${icon.fg};width:${size}px;height:${size}px;font-size:${monoFontSize}px;${icon.border ? `box-shadow:inset 0 0 0 1px ${icon.border};` : ''}`}
    >
      {icon.mono}
    </span>
    {withLabel && <span class="logo-icon-label">{icon.label}</span>}
  </span>
)}

<style is:global>
  .logo-icon-wrap {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .logo-icon-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .logo-icon-tile svg { width: 100%; height: 100%; }
  .logo-icon-mono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    font-family: var(--ff-h);
    font-weight: 700;
    letter-spacing: -0.01em;
    flex-shrink: 0;
    line-height: 1;
  }
  .logo-icon-label {
    font-family: var(--ff-h);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    white-space: nowrap;
  }
</style>
