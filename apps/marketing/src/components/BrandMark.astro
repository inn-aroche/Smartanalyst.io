---
// "The Ascent" logo mark — three ascending rounded bars + a detached cyan
// signal dot at the peak. Source: SmartAnalyst Brand Guidelines.
//
// Three variants:
//   gradient (default) — bar 1 light blue 45%, bar 2 gradient 78%, bar 3
//     gradient 100%, dot cyan. For dark surfaces and brand emphasis.
//   solid    — single currentColor (use on light surfaces in a single fill).
//   onLight  — bars #3D6BE0 (blue-deep) + cyan dot. Tuned for light bg.
//
// Each instance gets its own gradient id so multiple marks can coexist on
// the same page without colliding.

const { variant = 'gradient', size = 28 } = Astro.props;
// Stable-enough per-instance id so the gradient never collides.
const uid = `sa-grad-${Math.random().toString(36).slice(2, 9)}`;
---

{variant === 'gradient' && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 64 64"
    fill="none"
    role="img"
    aria-label="SmartAnalyst"
    style="display:block;flex-shrink:0"
  >
    <defs>
      <linearGradient id={uid} x1="0" y1="64" x2="64" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#5C8FFF" />
        <stop offset="100%" stop-color="#2DD9EE" />
      </linearGradient>
    </defs>
    <rect x="8"    y="40" width="11" height="16" rx="3" fill="#5C8FFF" opacity="0.45" />
    <rect x="22.5" y="26" width="11" height="30" rx="3" fill={`url(#${uid})`} opacity="0.78" />
    <rect x="37"   y="12" width="11" height="44" rx="3" fill={`url(#${uid})`} />
    <circle cx="42.5" cy="8" r="5" fill="#2DD9EE" />
  </svg>
)}

{variant === 'solid' && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 64 64"
    fill="currentColor"
    role="img"
    aria-label="SmartAnalyst"
    style="display:block;flex-shrink:0"
  >
    <rect x="8"    y="40" width="11" height="16" rx="3" opacity="0.45" />
    <rect x="22.5" y="26" width="11" height="30" rx="3" opacity="0.78" />
    <rect x="37"   y="12" width="11" height="44" rx="3" />
    <circle cx="42.5" cy="8" r="5" />
  </svg>
)}

{variant === 'onLight' && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 64 64"
    fill="none"
    role="img"
    aria-label="SmartAnalyst"
    style="display:block;flex-shrink:0"
  >
    <rect x="8"    y="40" width="11" height="16" rx="3" fill="#3D6BE0" opacity="0.45" />
    <rect x="22.5" y="26" width="11" height="30" rx="3" fill="#3D6BE0" opacity="0.82" />
    <rect x="37"   y="12" width="11" height="44" rx="3" fill="#3D6BE0" />
    <circle cx="42.5" cy="8" r="5" fill="#2DD9EE" />
  </svg>
)}
