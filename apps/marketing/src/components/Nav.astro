---
import { STRINGS, LOCALES, localizedPath, switchLocalePath } from '../i18n/strings.js';
import { PRODUCT_FEATURES } from '../data/product-features.js';
import { USE_CASES } from '../data/use-cases.js';
import BrandMark from './BrandMark.astro';

const { locale = 'en' } = Astro.props;
const t = STRINGS[locale];
const lp = (p) => localizedPath(p, locale);
const current = LOCALES.find((l) => l.code === locale);

// Build the "mega" submenu data, shared between desktop dropdowns and the
// mobile accordion. Keeps both renderers in sync from one source of truth.
const PRODUCT_LINKS = PRODUCT_FEATURES.map((f) => ({
  href: lp(`/product/${f.slug}`),
  title: locale === 'fr' ? f.fr.kicker : f.en.kicker,
  tagline: locale === 'fr' ? f.fr.tagline : f.en.tagline,
  icon: f.icon,
}));

const USE_CASE_LINKS = USE_CASES.map((u) => ({
  href: lp(`/use-cases/${u.slug}`),
  title: locale === 'fr' ? u.fr.kicker : u.en.kicker,
  tagline: locale === 'fr' ? u.fr.tagline : u.en.tagline,
  icon: u.icon,
}));

const RESOURCE_LINKS = [
  {
    href: lp('/resources'),
    title: locale === 'fr' ? 'Toutes les ressources' : 'All resources',
    tagline: locale === 'fr' ? 'Glossaire, guides, blog' : 'Glossary, guides, blog',
    icon: '◉',
  },
  {
    href: lp('/resources/glossary'),
    title: locale === 'fr' ? 'Glossaire marketing' : 'Marketing glossary',
    tagline: locale === 'fr' ? '40+ termes essentiels' : '40+ essential terms',
    icon: '◈',
  },
];
---
<nav class="nav" id="nav">
  <div class="nav-inner">
    <a href={lp('/')} class="brand">
      <BrandMark size={28} />
      <span class="brand-name">SmartAnalyst</span>
    </a>

    <!-- Desktop nav with dropdowns -->
    <div class="nav-links">
      <div class="nav-item">
        <a href={lp('/product')} class="nav-item-trigger" data-menu="product">
          {t.nav.product}<span class="nav-item-caret">▾</span>
        </a>
        <div class="nav-mega" data-menu-panel="product" data-align="left">
          <div class="nav-mega-inner">
            {PRODUCT_LINKS.map((l) => (
              <a href={l.href} class="nav-mega-link">
                <span class="nav-mega-icon">{l.icon}</span>
                <span class="nav-mega-copy">
                  <span class="nav-mega-title">{l.title}</span>
                  <span class="nav-mega-tagline">{l.tagline}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="nav-item">
        <a href={lp('/use-cases/agency')} class="nav-item-trigger" data-menu="use-cases">
          {t.nav.useCases}<span class="nav-item-caret">▾</span>
        </a>
        <div class="nav-mega" data-menu-panel="use-cases" data-align="center">
          <div class="nav-mega-inner nav-mega-narrow">
            {USE_CASE_LINKS.map((l) => (
              <a href={l.href} class="nav-mega-link">
                <span class="nav-mega-icon">{l.icon}</span>
                <span class="nav-mega-copy">
                  <span class="nav-mega-title">{l.title}</span>
                  <span class="nav-mega-tagline">{l.tagline}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href={lp('/pricing')}>{t.nav.pricing}</a>

      <div class="nav-item">
        <a href={lp('/resources')} class="nav-item-trigger" data-menu="resources">
          {t.nav.resources}<span class="nav-item-caret">▾</span>
        </a>
        <div class="nav-mega" data-menu-panel="resources" data-align="right">
          <div class="nav-mega-inner nav-mega-narrow">
            {RESOURCE_LINKS.map((l) => (
              <a href={l.href} class="nav-mega-link">
                <span class="nav-mega-icon">{l.icon}</span>
                <span class="nav-mega-copy">
                  <span class="nav-mega-title">{l.title}</span>
                  <span class="nav-mega-tagline">{l.tagline}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href={lp('/security')}>{t.nav.security}</a>
    </div>

    <!-- Desktop language selector -->
    <div class="lang-select" id="lang-select">
      <button class="lang-trigger" id="lang-trigger" aria-haspopup="listbox" aria-expanded="false">
        <span class="lang-flag">{current.flag}</span>
        <span class="lang-code">{locale.toUpperCase()}</span>
        <span class="lang-caret">▾</span>
      </button>
      <ul class="lang-menu" id="lang-menu" role="listbox" hidden>
        {LOCALES.map((l) => (
          <li role="option" aria-selected={l.code === locale}>
            <a href={switchLocalePath(Astro.url.pathname, l.code)} class={l.code === locale ? 'active' : ''}>
              <span class="lang-flag">{l.flag}</span>
              <span class="lang-name">{l.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Desktop login + CTA -->
    <a href="https://app.smartanalyst.io/login" class="nav-login">{t.nav.login}</a>
    <a href={lp('/#cta')} class="btn btn-primary btn-sm nav-cta">{t.nav.cta}</a>

    <!-- Mobile hamburger -->
    <button class="nav-burger" id="nav-burger" aria-label="Menu" aria-expanded="false" aria-controls="nav-mobile">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- Mobile drawer, MUST live outside <nav> to escape the backdrop-filter
     containing-block trap (otherwise its position:fixed gets re-anchored
     to the 64px-tall nav, making it invisible while scrolled). -->
<div class="nav-mobile" id="nav-mobile" hidden>
  <div class="nav-mobile-scroll">
    <div class="nav-mobile-inner">
      <!-- Product accordion -->
      <details class="nav-mobile-group" open>
        <summary>
          <span>{t.nav.product}</span>
          <span class="nav-mobile-caret">▾</span>
        </summary>
        <div class="nav-mobile-sub">
          <a href={lp('/product')} class="nav-mobile-sub-link nav-mobile-sub-overview">
            {locale === 'fr' ? 'Vue d’ensemble' : 'Overview'} →
          </a>
          {PRODUCT_LINKS.map((l) => (
            <a href={l.href} class="nav-mobile-sub-link">
              <span class="nav-mobile-sub-icon">{l.icon}</span>
              <span>
                <span class="nav-mobile-sub-title">{l.title}</span>
                <span class="nav-mobile-sub-tagline">{l.tagline}</span>
              </span>
            </a>
          ))}
        </div>
      </details>

      <!-- Use cases accordion -->
      <details class="nav-mobile-group">
        <summary>
          <span>{t.nav.useCases}</span>
          <span class="nav-mobile-caret">▾</span>
        </summary>
        <div class="nav-mobile-sub">
          {USE_CASE_LINKS.map((l) => (
            <a href={l.href} class="nav-mobile-sub-link">
              <span class="nav-mobile-sub-icon">{l.icon}</span>
              <span>
                <span class="nav-mobile-sub-title">{l.title}</span>
                <span class="nav-mobile-sub-tagline">{l.tagline}</span>
              </span>
            </a>
          ))}
        </div>
      </details>

      <!-- Pricing (flat) -->
      <a href={lp('/pricing')} class="nav-mobile-flat">
        <span>{t.nav.pricing}</span>
        <span class="nav-mobile-caret">→</span>
      </a>

      <!-- Resources accordion -->
      <details class="nav-mobile-group">
        <summary>
          <span>{t.nav.resources}</span>
          <span class="nav-mobile-caret">▾</span>
        </summary>
        <div class="nav-mobile-sub">
          {RESOURCE_LINKS.map((l) => (
            <a href={l.href} class="nav-mobile-sub-link">
              <span class="nav-mobile-sub-icon">{l.icon}</span>
              <span>
                <span class="nav-mobile-sub-title">{l.title}</span>
                <span class="nav-mobile-sub-tagline">{l.tagline}</span>
              </span>
            </a>
          ))}
        </div>
      </details>

      <!-- Security (flat) -->
      <a href={lp('/security')} class="nav-mobile-flat">
        <span>{t.nav.security}</span>
        <span class="nav-mobile-caret">→</span>
      </a>

      <!-- Login (flat) -->
      <a href="https://app.smartanalyst.io/login" class="nav-mobile-flat">
        <span>{t.nav.login}</span>
        <span class="nav-mobile-caret">→</span>
      </a>

      <div class="nav-mobile-sep"></div>

      <div class="nav-mobile-langs">
        {LOCALES.map((l) => (
          <a
            href={switchLocalePath(Astro.url.pathname, l.code)}
            class={`nav-mobile-lang ${l.code === locale ? 'active' : ''}`}
          >
            <span class="lang-flag">{l.flag}</span>
            <span>{l.label}</span>
          </a>
        ))}
      </div>

      <a href={lp('/#cta')} class="btn btn-primary nav-mobile-cta">{t.nav.cta}</a>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    // ━━━ Language dropdown (desktop) ━━━
    const trigger = document.getElementById('lang-trigger');
    const menu = document.getElementById('lang-menu');
    if (trigger && menu) {
      const closeLang = () => { menu.hidden = true; trigger.setAttribute('aria-expanded', 'false'); };
      const openLang  = () => { menu.hidden = false; trigger.setAttribute('aria-expanded', 'true'); };
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        menu.hidden ? openLang() : closeLang();
      });
      document.addEventListener('click', (e) => {
        if (!e.target.closest('#lang-select')) closeLang();
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLang(); });
    }

    // ━━━ Mobile drawer ━━━
    const burger = document.getElementById('nav-burger');
    const mobile = document.getElementById('nav-mobile');
    const nav = document.getElementById('nav');
    if (burger && mobile && nav) {
      const closeMobile = () => {
        mobile.hidden = true;
        burger.setAttribute('aria-expanded', 'false');
        nav.classList.remove('nav-open');
        document.body.style.overflow = '';
        document.body.style.position = '';
        document.body.style.width = '';
        const top = document.body.style.top;
        document.body.style.top = '';
        if (top) window.scrollTo(0, parseInt(top || '0', 10) * -1);
      };
      const openMobile = () => {
        const scrollY = window.scrollY;
        mobile.hidden = false;
        burger.setAttribute('aria-expanded', 'true');
        nav.classList.add('nav-open');
        // Lock body scroll while keeping the visible scroll position.
        // The combination of overflow:hidden + position:fixed + top is the
        // standard recipe that survives iOS Safari's rubber-band behavior.
        document.body.style.position = 'fixed';
        document.body.style.top = `-${scrollY}px`;
        document.body.style.width = '100%';
      };
      burger.addEventListener('click', () => {
        mobile.hidden ? openMobile() : closeMobile();
      });
      // Close when a link is clicked (not when an <details> summary toggles)
      mobile.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMobile));
      window.addEventListener('resize', () => {
        if (window.innerWidth > 900 && !mobile.hidden) closeMobile();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !mobile.hidden) closeMobile();
      });
    }

    // ━━━ Desktop dropdowns (hover-intent + click for keyboard / touch) ━━━
    const items = document.querySelectorAll('.nav-item');
    items.forEach((item) => {
      const trigger = item.querySelector('.nav-item-trigger');
      let timer = null;
      const open = () => {
        clearTimeout(timer);
        items.forEach((other) => other.classList.toggle('open', other === item));
      };
      const closeSoon = () => {
        timer = setTimeout(() => item.classList.remove('open'), 120);
      };
      item.addEventListener('mouseenter', open);
      item.addEventListener('mouseleave', closeSoon);
      trigger?.addEventListener('focus', open);
      trigger?.addEventListener('blur', closeSoon);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') items.forEach((i) => i.classList.remove('open'));
    });
  })();
</script>

<style is:global>
  /* ─── Language selector (desktop) ─── */
  .lang-select {
    position: relative;
    margin-right: 14px;
  }
  .lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-2);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    font-family: var(--ff-b);
    cursor: pointer;
    transition: all 0.15s;
  }
  .lang-trigger:hover {
    color: var(--text-1);
    border-color: var(--border-br);
    background: var(--card);
  }
  .lang-flag { font-size: 14px; line-height: 1; }
  .lang-code { font-family: var(--ff-m); letter-spacing: 0.05em; font-size: 11px; }
  .lang-caret { font-size: 9px; opacity: 0.6; }
  .lang-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    list-style: none;
    margin: 0;
    padding: 4px;
    background: var(--bg-2);
    border: 1px solid var(--border-br);
    border-radius: 8px;
    min-width: 160px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.55);
    z-index: 220;
  }
  .lang-menu li { margin: 0; }
  .lang-menu a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 5px;
    font-size: 13px;
    color: var(--text-2);
    transition: all 0.12s;
  }
  .lang-menu a:hover { background: var(--card-h); color: var(--text-1); }
  .lang-menu a.active { color: var(--text-1); background: rgba(61, 130, 255, 0.1); }
  .lang-menu .lang-name { font-family: var(--ff-b); }

  /* ─── Desktop dropdown items (Product, Use cases, Resources) ─── */
  .nav-item { position: relative; }
  .nav-item-trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
  }
  .nav-item-caret { font-size: 9px; opacity: 0.55; transition: transform 0.15s; }
  .nav-item.open .nav-item-caret { transform: rotate(180deg); }
  .nav-mega {
    position: absolute;
    top: calc(100% + 14px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s, transform 0.15s;
    z-index: 230;
    /* Bridge the gap between trigger and panel so the panel doesn't close
       when the cursor moves down to it */
    padding-top: 14px;
    margin-top: -14px;
    transform: translateY(6px);
  }
  /* Anchor based on the trigger's position in the nav so the panel never
     overflows the viewport. Product (leftmost) anchors its left edge,
     Resources (rightmost) anchors its right edge, Use cases (middle)
     centers. */
  .nav-mega[data-align="left"]   { left: 0; right: auto; }
  .nav-mega[data-align="right"]  { left: auto; right: 0; }
  .nav-mega[data-align="center"] { left: 50%; transform: translateX(-50%) translateY(6px); }
  .nav-item.open .nav-mega { opacity: 1; pointer-events: auto; transform: translateY(0); }
  .nav-item.open .nav-mega[data-align="center"] { transform: translateX(-50%) translateY(0); }
  .nav-mega-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 4px;
    width: 560px;
    max-width: calc(100vw - 32px);
    background: #0a0a13;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 12px;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.6),
      0 22px 50px rgba(0, 0, 0, 0.72);
    /* Belt-and-suspenders: anything that somehow escapes a grid cell
       still gets clipped inside the panel. */
    overflow: hidden;
  }
  .nav-mega-narrow {
    grid-template-columns: minmax(0, 1fr);
    width: 320px;
  }
  .nav-mega-link {
    display: flex;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 8px;
    color: var(--text-2);
    align-items: flex-start;
    transition: background 0.12s, color 0.12s;
    min-width: 0;
    max-width: 100%;
  }
  /* Visible hover — the previous var(--card-h) blended too much with the
     panel bg and the user couldn't see which item was active. */
  .nav-mega-link:hover {
    background: rgba(92, 143, 255, 0.12);
    color: var(--text-1);
  }
  .nav-mega-link:hover .nav-mega-icon { color: var(--cyan); }
  .nav-mega-icon {
    font-family: var(--ff-m);
    font-size: 16px;
    color: var(--cyan);
    margin-top: 1px;
    min-width: 18px;
    flex-shrink: 0;
  }
  .nav-mega-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1 1 0;
    /* If something still doesn't fit, ellipsis it rather than push the
       column wider. */
    overflow: hidden;
  }
  .nav-mega-title {
    font-family: var(--ff-h);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-1);
    letter-spacing: -0.01em;
    overflow-wrap: break-word;
    word-break: normal;
  }
  .nav-mega-tagline {
    font-family: var(--ff-b);
    font-size: 12px;
    color: var(--text-3);
    line-height: 1.4;
    overflow-wrap: break-word;
    word-break: normal;
    /* Hard cap at 2 lines, ellipsis the rest. Prevents any tagline from
       pushing the column taller than the others or wrapping awkwardly. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ─── Login link (desktop) ─── */
  .nav-login {
    font-size: 14.5px;
    color: var(--text-2);
    margin-right: 12px;
    transition: color 0.15s;
    white-space: nowrap;
  }
  .nav-login:hover { color: var(--text-1); }

  /* ─── Mobile burger ─── */
  .nav-burger {
    display: none;
    margin-left: auto;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    width: 40px;
    height: 36px;
    padding: 0;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 4px;
    transition: all 0.15s;
  }
  .nav-burger:hover { border-color: var(--border-br); background: var(--card); }
  .nav-burger span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text-1);
    border-radius: 1px;
    transition: transform 0.2s, opacity 0.2s;
  }
  .nav-open .nav-burger span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav-open .nav-burger span:nth-child(2) { opacity: 0; }
  .nav-open .nav-burger span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* ─── Mobile drawer ─── */
  .nav-mobile {
    /* Outside <nav>, so backdrop-filter on .nav doesn't trap our fixed layer. */
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(6, 6, 11, 0.97);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    z-index: 198; /* below the nav bar so the burger stays clickable */
    /* The drawer itself takes the full viewport; we scroll its inner div. */
    overflow: hidden;
  }
  .nav-mobile-scroll {
    height: 100%;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .nav-mobile-inner {
    padding: 24px 24px 48px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 540px;
    margin: 0 auto;
  }
  .nav-mobile-group {
    border: 1px solid var(--border);
    background: var(--card);
    border-radius: 12px;
    overflow: hidden;
  }
  .nav-mobile-group > summary {
    list-style: none;
    cursor: pointer;
    padding: 16px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--ff-h);
    font-size: 17px;
    font-weight: 600;
    color: var(--text-1);
    user-select: none;
  }
  .nav-mobile-group > summary::-webkit-details-marker { display: none; }
  .nav-mobile-caret {
    font-size: 12px;
    opacity: 0.6;
    transition: transform 0.2s;
  }
  .nav-mobile-group[open] .nav-mobile-caret { transform: rotate(180deg); }
  .nav-mobile-sub {
    padding: 4px 8px 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-top: 1px solid var(--border);
  }
  .nav-mobile-sub-link {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--text-2);
  }
  .nav-mobile-sub-link:hover { background: var(--card-h); color: var(--text-1); }
  .nav-mobile-sub-overview {
    font-family: var(--ff-m);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
    padding: 8px 12px;
  }
  .nav-mobile-sub-icon {
    font-family: var(--ff-m);
    font-size: 14px;
    color: var(--cyan);
    min-width: 18px;
    margin-top: 2px;
  }
  .nav-mobile-sub-title {
    display: block;
    font-family: var(--ff-h);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--text-1);
    margin-bottom: 1px;
  }
  .nav-mobile-sub-tagline {
    display: block;
    font-family: var(--ff-b);
    font-size: 12.5px;
    color: var(--text-3);
    line-height: 1.4;
  }
  .nav-mobile-flat {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 18px;
    border: 1px solid var(--border);
    background: var(--card);
    border-radius: 12px;
    font-family: var(--ff-h);
    font-size: 17px;
    font-weight: 600;
    color: var(--text-1);
  }
  .nav-mobile-sep { height: 16px; }
  .nav-mobile-langs {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }
  .nav-mobile-lang {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 14px;
    color: var(--text-2);
    background: var(--card);
  }
  .nav-mobile-lang.active {
    color: var(--text-1);
    background: rgba(61, 130, 255, 0.1);
    border-color: rgba(61, 130, 255, 0.35);
  }
  .nav-mobile-cta {
    width: 100%;
    text-align: center;
    justify-content: center;
