---
// Row of connector / source logos.
//
// Variants:
//   default   → pill: small logo + brand name
//   cards     → white rounded tiles, logo centered, no label
//   marquee   → continuous horizontal auto-scroll, no tiles, fades at edges
//
// Each item is either:
//   { icon: 'ga4' }       → real SVG via <LogoIcon>
//   { label, color }      → colored-dot + text fallback (default variant only)
import LogoIcon from './LogoIcon.astro';
import { LOGO_ICONS } from '../data/connector-logos.js';

const {
  label,
  items,
  align = 'center',
  size = 22,
  variant = 'default',
  cardSize = 64,
  logoSize,
  marqueeDuration = 38,
} = Astro.props;

const _logoSize = logoSize ?? Math.round(cardSize * 0.55);
const _marqueeLogoSize = logoSize ?? 32;
---
{variant === 'marquee' ? (
  <div class="logo-marquee">
    {label && <div class="logo-marquee-label">{label}</div>}
    <div class="logo-marquee-mask">
      <div class="logo-marquee-track" style={`animation-duration:${marqueeDuration}s`}>
        {[...items, ...items, ...items].map((item) => (
          item.icon && LOGO_ICONS[item.icon] ? (
            <span class="logo-marquee-item" aria-label={LOGO_ICONS[item.icon].label}>
              <LogoIcon name={item.icon} size={_marqueeLogoSize} withLabel={false} />
            </span>
          ) : (
            <span class="logo-marquee-item">
              {item.color && <span class="lp-dot" style={`background:${item.color}`}></span>}
              <span>{item.label}</span>
            </span>
          )
        ))}
      </div>
    </div>
  </div>
) : variant === 'cards' ? (
  <div class="logo-cards" style={align === 'left' ? 'justify-content:flex-start' : ''}>
    {items.map((item) => (
      item.icon && LOGO_ICONS[item.icon] ? (
        <span class="logo-card" style={`width:${cardSize}px;height:${cardSize}px`} aria-label={LOGO_ICONS[item.icon].label}>
          <LogoIcon name={item.icon} size={_logoSize} withLabel={false} />
        </span>
      ) : (
        <span class="logo-card" style={`width:${cardSize}px;height:${cardSize}px`}>
          {item.color && <span class="lp-dot" style={`background:${item.color}`}></span>}
        </span>
      )
    ))}
  </div>
) : (
  <div class="logo-strip" style={align === 'left' ? 'justify-content:flex-start' : ''}>
    {label && <span class="logo-strip-label">{label}</span>}
    {items.map((item) => (
      item.icon && LOGO_ICONS[item.icon] ? (
        <span class="logo-pill logo-pill-icon">
          <LogoIcon name={item.icon} size={size} withLabel={true} />
        </span>
      ) : (
        <span class="logo-pill">
          {item.color && <span class="lp-dot" style={`background:${item.color}`}></span>}
          <span>{item.label}</span>
        </span>
      )
    ))}
  </div>
)}

<style is:global>
  /* ── Card variant (kept for back-compat) ── */
  .logo-cards {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 8px 0;
  }
  .logo-card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border-radius: 14px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.4),
      0 12px 28px rgba(0, 0, 0, 0.35),
      inset 0 0 0 1px rgba(255, 255, 255, 0.05);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    flex-shrink: 0;
  }
  .logo-card:hover {
    transform: translateY(-2px);
  }
  .logo-card .logo-icon-wrap { gap: 0; }
  .logo-card .logo-icon-mono { border-radius: 8px; }

  /* ── Marquee variant ── */
  .logo-marquee {
    width: 100%;
  }
  .logo-marquee-label {
    font-family: var(--ff-m);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
    text-align: center;
    margin-bottom: 18px;
  }
  .logo-marquee-mask {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
  }
  .logo-marquee-track {
    display: flex;
    align-items: center;
    gap: 56px;
    width: max-content;
    animation: logo-marquee linear infinite;
    will-change: transform;
  }
  .logo-marquee-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.78;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }
  .logo-marquee-item:hover { opacity: 1; }
  /* Each set was duplicated 3×, translating by -33.333% loops one full set. */
  @keyframes logo-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-33.333%); }
  }
  /* Pause on user prefers reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    .logo-marquee-track { animation: none; }
  }
</style>
