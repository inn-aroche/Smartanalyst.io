# Backend API base URL — must NOT include trailing slash.
# Dev: relies on Vite proxy, so this stays empty (calls go to /api → localhost:3000).
# Prod: set at build time in GitHub Actions to https://api.smartanalyst.io.
VITE_API_URL=

# PostHog cloud EU — measurement plan §6 (Lot 0). Si vide, le wrapper
# lib/tracking.ts est no-op silencieux : aucun event émis, aucun call
# réseau. Aucun event n'est envoyé tant que l'utilisateur n'a pas
# consenti à analytics (Consent Mode v2 — lib/consent.ts).
VITE_POSTHOG_KEY=
# Optionnel. Par défaut https://eu.i.posthog.com (cohérent ADR-0003 :
# gouvernance des données EU). Ne pas pointer vers us.i.posthog.com.
VITE_POSTHOG_HOST=
