# nginx site config for the SmartAnalyst API (reverse proxy → Node :3000).
#
# Install:
#   1. Replace __DOMAIN__ with your API hostname (e.g. api.smartanalyst.io):
#        sed 's/__DOMAIN__/api.smartanalyst.io/g' scripts/vps-nginx-api.conf.template \
#          | sudo tee /etc/nginx/sites-available/smartanalyst-api > /dev/null
#   2. Enable the site:
#        sudo ln -s /etc/nginx/sites-available/smartanalyst-api /etc/nginx/sites-enabled/
#        sudo rm -f /etc/nginx/sites-enabled/default
#        sudo nginx -t && sudo systemctl reload nginx
#   3. Get TLS:
#        sudo certbot --nginx -d __DOMAIN__
#      (certbot will rewrite this file to add the TLS server block + redirect.)

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # certbot uses this path for the http-01 challenge during renewal
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # API
    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";

        # Stripe webhooks and long-running AI requests can take a while
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;

        # Big upload (CSV / files connector)
        client_max_body_size 25m;
    }

    # Lightweight access log, no log for the health endpoint
    access_log /var/log/nginx/smartanalyst-api.access.log;
    error_log  /var/log/nginx/smartanalyst-api.error.log;
}
